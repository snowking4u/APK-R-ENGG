/* ========================================================================== *
 * APK Reverse Engineering IDE - Dark theme (Phase 01)
 * Consistent developer-tool palette. Compact, no animations, no rounded cards.
 * ========================================================================== */

QWidget {
    background-color: #1e1f22;
    color: #d4d4d4;
    font-family: "Segoe UI";
    font-size: 12px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

/* ----- Main window / central area ---------------------------------------- */
QMainWindow {
    background-color: #1e1f22;
}

QMainWindow::separator {
    background-color: #2d2e31;
    width: 1px;
    height: 1px;
}

QDialog {
    background-color: #252629;
}

/* ----- Menu bar ----------------------------------------------------------- */
QMenuBar {
    background-color: #252629;
    color: #d4d4d4;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #37383c;
    border-radius: 3px;
}

QMenu {
    background-color: #252629;
    border: 1px solid #3c3c3c;
    padding: 4px;
}

QMenu::item {
    padding: 5px 22px 5px 22px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #37383c;
}

QMenu::item:disabled {
    color: #6b6b6b;
}

QMenu::separator {
    height: 1px;
    background-color: #3c3c3c;
    margin: 4px 8px;
}

/* ----- Toolbar ------------------------------------------------------------ */
QToolBar {
    background-color: #252629;
    border-bottom: 1px solid #3c3c3c;
    padding: 3px 6px;
    spacing: 3px;
}

QToolBar::separator {
    background-color: #3c3c3c;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    color: #d4d4d4;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #37383c;
    border-color: #45464a;
}

QToolButton:pressed {
    background-color: #2f3034;
}

QToolButton:disabled {
    color: #6b6b6b;
}

/* ----- Dock widgets -------------------------------------------------------- */
QDockWidget {
    color: #d4d4d4;
}

QDockWidget::title {
    background-color: #252629;
    border-bottom: 1px solid #3c3c3c;
    padding: 5px 8px;
    font-weight: bold;
}

QDockWidget::title:hover {
    background-color: #2b2c30;
}

/* ----- Tab widgets ---------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background-color: #1e1f22;
    top: -1px;
}

QTabWidget::pane:first {
    border-top: 0;
}

QTabBar::tab {
    background-color: #252629;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    padding: 5px 14px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #1e1f22;
    color: #ffffff;
    border-bottom: 2px solid #4a9eff;
}

QTabBar::tab:hover:!selected {
    background-color: #2b2c30;
}

/* ----- Tree / list ----------------------------------------------------------- */
QTreeWidget, QTreeView, QListView {
    background-color: #1e1f22;
    alternate-background-color: #232427;
    border: none;
    outline: none;
}

QTreeWidget::item,
QTreeView::item,
QListView::item {
    padding: 3px 2px;
}

QTreeWidget::item:hover,
QTreeView::item:hover {
    background-color: #2b2c30;
}

QTreeWidget::item:selected,
QTreeView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #252629;
    color: #d4d4d4;
    border: none;
    border-bottom: 1px solid #3c3c3c;
    padding: 4px 8px;
    font-weight: bold;
}

/* ----- Plain text editors ------------------------------------------------------ */
QPlainTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    font-family: "Consolas";
    font-size: 13px;
}

QPlainTextEdit:focus {
    border: none;
}

/* ----- Line number gutter ------------------------------------------------------- */
QWidget#LineNumberArea {
    background-color: #1e1e1e;
    color: #6b6b6b;
    border-right: 1px solid #2d2e31;
}

/* ----- Status bar ------------------------------------------------------------------ */
QStatusBar {
    background-color: #252629;
    border-top: 1px solid #3c3c3c;
    color: #d4d4d4;
}

QStatusBar::item {
    border: none;
}

QLabel#StatusLabel {
    color: #a8cd83;
    padding-left: 6px;
    padding-right: 6px;
}

QLabel#InfoLabel {
    color: #9cdcfe;
    padding-left: 10px;
    padding-right: 10px;
}

QLabel#MutedLabel {
    color: #808080;
    padding-left: 10px;
    padding-right: 10px;
}

/* ----- Splitter ------------------------------------------------------------------------ */
QSplitter::handle {
    background-color: #2d2e31;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4a9eff;
}

/* ----- Buttons --------------------------------------------------------------------------- */
QPushButton {
    background-color: #33363a;
    border: 1px solid #45464a;
    border-radius: 3px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #3a3d42;
}

QPushButton:pressed {
    background-color: #2f3034;
}

QPushButton:disabled {
    color: #6b6b6b;
    background-color: #28292b;
    border-color: #33363a;
}

QPushButton#PrimaryButton {
    background-color: #0e639c;
    border-color: #1177bb;
    color: #ffffff;
}

QPushButton#PrimaryButton:hover {
    background-color: #1177bb;
}

/* ----- Inputs ------------------------------------------------------------------------------ */
QLineEdit, QComboBox, QSpinBox {
    background-color: #2b2c30;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #264f78;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #4a9eff;
}

QComboBox QAbstractItemView {
    background-color: #252629;
    border: 1px solid #3c3c3c;
    selection-background-color: #264f78;
}

/* ----- Scrollbars --------------------------------------------------------------------------*/
QScrollBar:vertical {
    background-color: #1e1f22;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #43454a;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4c52;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1e1f22;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #43454a;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a4c52;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* ----- Tooltips ----------------------------------------------------------------------------*/
QToolTip {
    background-color: #2b2c30;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    padding: 4px 6px;
}